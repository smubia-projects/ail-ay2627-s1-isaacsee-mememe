{
  "name": "mememe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:server": "tsx watch --conditions=react-server --env-file-if-exists=.env server/server.ts",
    "build:server": "esbuild server/server.ts --bundle --platform=node --target=node22 --format=cjs --conditions=react-server --outfile=server/dist/server.js --log-level=warning",
    "start:server": "node server/dist/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "eval:safety": "tsx safety-eval/run.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "framer-motion": "^14.3.0",
    "jszip": "^3.10.2",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
