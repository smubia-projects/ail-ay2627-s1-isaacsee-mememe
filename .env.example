# MemeMe API (server/, Cloud Run). Copy to .env for local dev (`npm run dev:server`).
# For deploys the whole file is uploaded as the DOTENV repo secret:
#   gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-isaacsee-mememe < .env
# Keep values on their own lines (no inline comments after a value). Never commit real keys.

# --- OpenRouter (required) ---
# Key from https://openrouter.ai/keys. Set a credit limit on it as a hard cost cap.
OPENROUTER_API_KEY=your-openrouter-key-here
# Vision + JSON model for the safety gate, analysis, ranking, captions and moderation.
# The safety eval (safety-eval/) was tuned on this model; re-run it if you change it.
OPENROUTER_TEXT_MODEL=google/gemini-3.5-flash-lite
# Image-output model for the sticker stylizer; must also accept image input.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# Deployed frontend URL, sent to OpenRouter as the HTTP-Referer header.
SITE_URL=http://localhost:3000

# --- CORS (required in production) ---
# Comma-separated frontend origins, e.g. the Vercel URL. Empty = allow any origin (local dev only).
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting (shared Upstash Redis; unset = limiting disabled) ---
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Fallback limits per IP per window; the central control sheet overrides them at runtime.
RATE_LIMIT_ANALYZE_MAX=10
RATE_LIMIT_MATCH_MAX=5
RATE_LIMIT_GENERATION_MAX=5
RATE_LIMIT_STYLIZE_MAX=5
RATE_LIMIT_MODERATE_MAX=20
RATE_LIMIT_WINDOW_SECONDS=432000

# PORT is injected by Cloud Run (defaults to 8080 locally).

# --- Frontend (Next.js, Vercel) ---
# Set these in Vercel -> Settings -> Environment Variables. Next.js also reads them from this
# .env in local dev; NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# Cloud Run URL of the API (no trailing slash). Defaults to http://localhost:8080 when unset.
NEXT_PUBLIC_API_BASE=http://localhost:8080
# Deployed frontend URL, used for OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
