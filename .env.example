# Copy to .env.local and fill in. Never commit real keys.
GEMINI_API_KEY=
# Gemini Flash-tier multimodal model (check https://ai.google.dev/gemini-api/docs/models)
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
# Image-output model that also accepts image input (check https://openrouter.ai/models)
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# Deployed URL, used for the OpenRouter HTTP-Referer header and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
